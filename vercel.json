{
  "installCommand": "git lfs pull && npm install",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "giltmedia.work" }],
      "destination": "https://www.giltmedia.work/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "hazem-designs.vercel.app" }],
      "destination": "https://www.giltmedia.work/:path*",
      "permanent": true
    }
  ]
}
